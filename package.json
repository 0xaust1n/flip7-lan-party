{
  "name": "flip-7",
  "version": "1.0.0",
  "private": true,
  "packageManager": "bun@1.2.22",
  "type": "module",
  "scripts": {
    "dev": "bun run build:client && bun --env-file=.env --hot src/server.ts",
    "start": "bun run build:client && bun --env-file=.env src/server.ts",
    "build:client": "bun run build:client:js && bun run build:client:css",
    "build:client:js": "NODE_ENV=production bun build ./src/client/app.js --outfile ./public/app.js --target browser --format esm --minify",
    "build:client:css": "tailwindcss -i ./src/client/styles.css -o ./public/styles.css --minify",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.2.1",
    "@types/ioredis": "^5.0.0",
    "@types/node": "^25.3.2",
    "bun-types": "^1.3.10",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "htm": "^3.1.1",
    "ioredis": "^5.10.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  }
}
